# Copy to .env and fill in. Never commit .env.

# LLM in "provider:model" form, passed to LangChain's init_chat_model.
LLM_MODEL=openai:gpt-6-luna
OPENAI_API_KEY=your-openai-api-key-here

# Where the JPL ephemeris is cached (optional, default ~/.cache/sky-tonight).
# SKY_TONIGHT_CACHE=/path/to/cache
